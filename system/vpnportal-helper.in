#!/bin/bash
# vpnportal-helper — la ÚNICA puerta para lanzar gpclient como root.
#
# Meson lo instala (propiedad de root) en @SBINDIR@ rellenando las rutas
# marcadas con @...@. Tiene dos órdenes:
#
#   allow <host>...      Aprueba servidores. Se ejecuta con pkexec, así que
#                        pide contraseña. La app lo usa la primera vez que
#                        conectas a un portal/gateway nuevo.
#
#   connect <portal> [--gateway <host>] [--user <usuario>] [--hip]
#                        Conecta. sudoers permite esto SIN contraseña, pero
#                        solo a servidores aprobados con "allow".
#
# Todo lo que llega aquí se trata como si viniera de un atacante: solo se
# aceptan las opciones de la lista y cada valor se valida. Las opciones
# peligrosas de gpclient (-s script, --hip <script>, --cookie-cache <ruta>,
# certificados...) son imposibles de pasar.

set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 022

GPCLIENT=/usr/bin/gpclient
ALLOWLIST=/etc/vpnportal/allowed-hosts
# Sustituto de gpauth que muestra el login dentro de la app.
AUTH_BINARY=@LIBEXECDIR@/vpnportal-auth

die() {
  echo "vpnportal-helper: $*" >&2
  exit 2
}

# Las mismas reglas que vpn_config_host_is_valid / _user_is_valid en la app.
# Ninguna permite empezar por "-", así no se puede colar una opción.
valid_host() { [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$ ]]; }
valid_user() { [[ "$1" =~ ^[A-Za-z0-9._@+][A-Za-z0-9._@+-]{0,127}$ ]]; }

# -x línea entera, -F texto literal (no regex), -i sin distinguir mayúsculas.
is_approved() { [[ -f "$ALLOWLIST" ]] && grep -qixF -- "$1" "$ALLOWLIST"; }

cmd_allow() {
  [[ $# -ge 1 ]] || die "usage: allow <host>..."
  # Primero se validan TODOS; si alguno falla, no se escribe nada.
  local host
  for host in "$@"; do
    valid_host "$host" || die "invalid host: $host"
  done

  mkdir -p "$(dirname "$ALLOWLIST")"
  for host in "$@"; do
    host="${host,,}"   # a minúsculas
    is_approved "$host" || echo "$host" >> "$ALLOWLIST"
    echo "Approved: $host"
  done
}

cmd_connect() {
  [[ $# -ge 1 ]] || die "usage: connect <portal> [--gateway H] [--user U] [--hip]"
  local portal="$1"
  shift
  valid_host "$portal" || die "invalid portal: $portal"
  is_approved "$portal" || die "portal not approved: $portal"

  local args=() gateway=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --gateway)
        [[ $# -ge 2 ]] || die "missing value for --gateway"
        valid_host "$2" || die "invalid gateway: $2"
        is_approved "$2" || die "gateway not approved: $2"
        gateway="$2"
        args+=("--gateway=$2")
        shift 2
        ;;
      --user)
        [[ $# -ge 2 ]] || die "missing value for --user"
        valid_user "$2" || die "invalid user: $2"
        args+=("--user=$2")
        shift 2
        ;;
      --hip)
        args+=("--hip")
        shift
        ;;
      *)
        die "option not allowed: $1"
        ;;
    esac
  done

  # Sin gateway concreta, gpclient preguntaría por teclado: que elija sola.
  [[ -n "$gateway" ]] || args+=("--auto-gateway")

  # Si está instalado, gpclient usará nuestro login (dentro de la app) en
  # vez de abrir la ventana de gpauth. La ruta es fija y de root: nadie
  # puede cambiar qué programa se lanza. (gpclient lo ejecuta como tu
  # usuario, no como root.)
  if [[ -x "$AUTH_BINARY" ]]; then
    export GP_AUTH_BINARY="$AUTH_BINARY"
  fi

  # "--opcion=valor" y el "--" antes del portal: así gpclient nunca puede
  # confundir un valor con una opción.
  exec "$GPCLIENT" connect "${args[@]}" -- "$portal"
}

case "${1:-}" in
  connect) shift; cmd_connect "$@" ;;
  allow)   shift; cmd_allow "$@" ;;
  *)       die "usage: vpnportal-helper connect|allow ..." ;;
esac
